{
  "name": "tooldrill",
  "version": "0.1.0",
  "description": "Deterministic MCP tool-manifest conformance and boundary tester.",
  "type": "module",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": ["dist/src", "fixtures", "README.md", "LICENSE", "docs"],
  "engines": { "node": ">=22" },
  "bin": { "tooldrill": "dist/src/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:smoke": "node scripts/package-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/src/cli.js demo artifacts/demo",
    "check": "npm run test && npm run demo"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nripankadas07/tooldrill.git"
  },
  "homepage": "https://github.com/nripankadas07/tooldrill#readme",
  "bugs": {
    "url": "https://github.com/nripankadas07/tooldrill/issues"
  },
  "license": "MIT"
}
